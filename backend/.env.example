NODE_ENV=development
PORT=4000
# Public site URL. In production with SERVE_FRONTEND=true this is the live domain, e.g. https://www.example.com
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/projectx.sqlite
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
# Production: true serves the built website from this server, so the site and /api share one domain
SERVE_FRONTEND=false
# Optional: location of the built site (defaults to ../frontend/dist)
FRONTEND_DIST=
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional Resend email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Optional Twilio SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Company phone that receives staff alerts (new requests, job applications, website problems)
STAFF_SMS_NUMBER=+12024603027
# Optional: email address that receives "website problem" alerts (sent through Resend)
ALERT_EMAIL=
