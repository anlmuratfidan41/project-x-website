# Production settings for https://projectx.build
# Copy to backend/.env on the server (or enter these in the host's environment settings).
# Never commit the real file: it holds passwords and API keys.

NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=https://projectx.build
SERVE_FRONTEND=true
COOKIE_SECURE=true
# true when the host terminates HTTPS in front of the app (Render, Railway, Fly.io, Nginx, ...)
TRUST_PROXY=true

# Must be on a persistent disk that is backed up
DATABASE_PATH=/var/data/projectx.sqlite

# First start on an empty database creates this owner account (password 12+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (Resend) — verify projectx.build in Resend first (adds SPF/DKIM DNS records)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Project X Contractors <noreply@projectx.build>
RESEND_REPLY_TO_EMAIL=
# Receives "website problem" alerts
ALERT_EMAIL=

# SMS (Twilio) — optional at launch; US business texting needs A2P 10DLC registration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STAFF_SMS_NUMBER=+12024603027
